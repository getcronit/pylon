{
  "name": "root",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ]
  },
  "scripts": {
    "changeset": "changeset --",
    "ci:release": "changeset publish",
    "ci:version": "changeset version && pnpm i --no-frozen-lockfile --lockfile-only --ignore-scripts",
    "clean": "pnpm -r --filter \"./packages/*\" exec -- rimraf dist",
    "build": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.190",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.12",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^18.14.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.0.0",
    "semantic-release-monorepo": "^8.0.2",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "graphql": "^16.9.0"
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.9.0"
    }
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
