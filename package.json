{
  "name": "root",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ]
  },
  "scripts": {
    "changeset": "changeset --",
    "ci:release": "changeset publish",
    "ci:version": "changeset version && pnpm i --no-frozen-lockfile --lockfile-only --ignore-scripts",
    "clean": "pnpm -r --filter \"./packages/*\" exec -- rimraf dist",
    "build": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.190",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^18.14.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.0.0",
    "semantic-release-monorepo": "^8.0.2",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "graphql": "^16.9.0"
  },
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3"
}
