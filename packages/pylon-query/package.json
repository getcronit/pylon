  },
  "homepage": "https://pylon.cronit.io",
  "dependencies": {
    "graphql": "^16.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
