{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "noImplicitThis": false,
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "baseUrl": "./src",
    "outDir": "./dist"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
