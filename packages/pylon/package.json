{
  "name": "@getcronit/pylon",
  "version": "2.9.5",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tsconfig.pylon.json": "./tsconfig.pylon.json"
  },
  "scripts": {
    "build": "rimraf ./dist && node build.js && pnpm run build:declarations",
    "build:declarations": "tsc --declaration --emitDeclarationOnly --outDir ./dist && tsc-alias"
  },
  "files": [
    "dist",
    "tsconfig.pylon.json"
  ],
  "author": "Nico Schett <nico.schett@cronit.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/getcronit/pylon.git",
    "directory": "packages/pylon"
  },
  "homepage": "https://pylon.cronit.io",
  "dependencies": {
    "@envelop/core": "^5.0.3",
    "@graphql-tools/delegate": "^12.0.9",
    "@graphql-tools/executor-http": "^3.1.0",
    "@graphql-tools/wrap": "^11.1.9",
    "@graphql-yoga/plugin-disable-introspection": "^2.13.0",
    "@hono/sentry": "^1.2.0",
    "@sentry/bun": "^8.17.0",
    "@sentry/node": "^8.54.0",
    "consola": "^3.2.3",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.24.0",
    "graphql-yoga": "^5.6.2",
    "hono": "^4.0.8",
    "toucan-js": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@sentry/types": "^8.54.0",
    "tsc-alias": "^1.8.11",
    "vitest": "^2.0.0"
  }
}
