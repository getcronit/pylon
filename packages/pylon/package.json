      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/types": "^8.54.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.23.1",
    "graphql": "^16.9.0",
    "hono": "^4.0.0",
    "rimraf": "^6.0.1",
    "rolldown": "1.2.4",
