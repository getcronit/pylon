    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/bun": "^8.17.0",
    "@sentry/node": "^8.54.0",
    "@sentry/react": "^10.5.0",
    "bullmq": "^5.0.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
