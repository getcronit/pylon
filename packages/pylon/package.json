{
  "name": "@getcronit/pylon",
  "version": "2.9.5",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "bin": {
    "pylon": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./ir": {
      "import": "./dist/ir/index.js",
      "types": "./dist/ir/index.d.ts"
    },
    "./query/build": {
      "import": "./dist/query/build/index.js",
      "types": "./dist/query/build/index.d.ts"
    },
    "./db": {
      "import": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    },
    "./db/plugin": {
      "import": "./dist/db/plugin.js",
      "types": "./dist/db/plugin.d.ts"
    },
    "./queues": {
      "import": "./dist/queues/index.js",
      "types": "./dist/queues/index.d.ts"
    },
    "./queues/plugin": {
      "import": "./dist/queues/plugin.js",
      "types": "./dist/queues/plugin.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./auth/plugin": {
      "import": "./dist/auth/plugin.js",
      "types": "./dist/auth/plugin.d.ts"
    },
    "./auth/contract": {
      "import": "./dist/auth/contract.js",
      "types": "./dist/auth/contract.d.ts"
    },
    "./auth/zitadel": {
      "import": "./dist/auth/zitadel.js",
      "types": "./dist/auth/zitadel.d.ts"
    },
    "./pages": {
      "import": "./dist/pages/index.js",
      "types": "./dist/pages/index.d.ts"
    },
    "./pages/plugin": {
      "import": "./dist/pages/plugin.js",
      "types": "./dist/pages/plugin.d.ts"
    },
    "./pages/index.css": "./dist/pages/index.css",
    "./query": {
      "import": "./dist/query/index.js",
      "types": "./dist/query/index.d.ts"
    },
    "./tsconfig.pylon.json": "./tsconfig.pylon.json"
  },
  "scripts": {
    "build": "rimraf ./dist && node build.js && pnpm run build:declarations",
    "build:declarations": "tsc -p tsconfig.typecheck.json --declaration --emitDeclarationOnly --outDir ./dist && tsc-alias",
    "test": "vitest run",
    "test:integration": "PYLON_ORM_IT=1 vitest run test/db/integration",
    "test:integration:queues": "PYLON_QUEUES_IT=1 vitest run test/queues/integration",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "node scripts/check-boundaries.mjs && tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p test/tsconfig.json"
  },
  "files": [
    "dist",
    "tsconfig.pylon.json"
  ],
  "author": "Nico Schett <nico.schett@cronit.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/getcronit/pylon.git",
    "directory": "packages/pylon"
  },
  "homepage": "https://pylon.cronit.io",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@envelop/core": "^5.0.3",
    "@graphql-tools/delegate": "^12.0.9",
    "@graphql-tools/executor-http": "^3.1.0",
    "@graphql-tools/wrap": "^11.1.9",
    "@graphql-yoga/plugin-disable-introspection": "^2.13.0",
