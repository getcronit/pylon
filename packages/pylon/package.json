    "graphql-yoga": "^5.6.2",
    "hono": "^4.0.8",
    "ioredis": "^5.4.0",
    "kysely": "^0.27.4",
    "lucide-react": "^0.474.0",
    "mime": "^4.0.6",
    "mitt": "^3.0.1",
    "openid-client": "^6.1.7",
    "pg": "^8.13.1",
    "postcss-load-config": "^6.0.1",
    "postcss-value-parser": "^4.2.0",
    "posthog-node": "^4.10.1",
    "react-router": "^7.1.5",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tiny-glob": "^0.2.9",
    "toucan-js": "^4.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "@bull-board/api": "*",
    "@bull-board/hono": "*",
    "@tailwindcss/postcss": "^4.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
