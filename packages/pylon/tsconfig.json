{
  "compilerOptions": {
    // add Bun type definitions

    // enable latest features
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",

    "moduleResolution": "bundler", // support `import` from `node_modules`
    "noImplicitAny": false,
    "noImplicitThis": false,

    "jsx": "react-jsx", // support JSX
    "allowJs": true, // allow importing `.js` from `.ts`
    "esModuleInterop": true, // allow default imports for CommonJS modules

    // best practices
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "rootDir": "./src",
    "baseUrl": "./src",
    "outDir": "./dist",
    // NOTE: the @getcronit/pylon self-reference paths live in tsconfig.typecheck.json
    // (used by `tsc` for declarations), NOT here. esbuild reads THIS file per-source,
    // and if the self-refs were here it would rewrite `@getcronit/pylon/ir` into an
    // external `../ir` directory import (invalid ESM). Without them, esbuild treats
    // self-refs as external packages that resolve at runtime via the exports map.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*"
  ]
}
