exports[`Pylon Builder - Inputs and Arguments > should handle nested arguments (the standard Pylon pattern) 1`] = `
{
  "resolvers": {},
  "typeDefs": "type Query {
  user(args: UserArgsInput!): User!
}

type Mutation {
  createUser(args: CreateUserArgsInput!): CreateUser!
}

type User {
  username: String!
}

type CreateUser {
  username: String!
}

input UserArgsInput {
  id: String!
}

input CreateUserArgsInput {
  input: CreateUserInput!
}

input CreateUserInput {
  username: String!
  email: String
}

scalar String

scalar ID

scalar Int

scalar Float

scalar Boolean

scalar Number

scalar Any

scalar Void

scalar JSONObject

scalar File

scalar Date

scalar JSON
",
}
`;

