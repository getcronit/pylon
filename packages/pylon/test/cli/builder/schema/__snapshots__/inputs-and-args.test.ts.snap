// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Pylon Builder - Inputs and Arguments > does not merge same-named nested inputs that differ only by OPTIONAL fields 1`] = `
{
  "resolvers": {},
  "typeDefs": "type Mutation {
  createInvoice(args: CreateInvoiceArgsInput!): CreateInvoice!
  createDelivery(args: CreateDeliveryArgsInput!): CreateDelivery!
}

type CreateInvoice {
  ok: Boolean!
}

type CreateDelivery {
  ok: Boolean!
}

input CreateInvoiceArgsInput {
  input: Input!
}

input Input {
  title: String!
  lines: [PricedLineInput!]!
}

input PricedLineInput {
  description: String!
  quantity: Number
  unitPrice: Number
}

input CreateDeliveryArgsInput {
  input: Input_1!
}

input Input_1 {
  title: String!
  lines: [FreeLineInput!]!
}

input FreeLineInput {
  description: String!
  quantity: Number
}

scalar String

scalar ID

scalar Int

scalar Float

scalar Boolean

scalar Number

scalar Any

scalar Void

scalar JSONObject

scalar File

scalar Date

scalar JSON
",
}
`;

