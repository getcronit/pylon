{
  // Used by `tsc` (build:declarations) — adds the @getcronit/pylon self-reference
  // paths so the consolidated source typechecks against ./src. esbuild deliberately
  // does NOT use this (it reads tsconfig.json, which omits these) so it externalizes
  // self-refs for runtime exports resolution. No baseUrl (deprecated) → paths carry
  // the ./src/ prefix, resolved relative to this config's directory.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@getcronit/pylon": ["./src/core/index.ts"],
      "@getcronit/pylon/*": ["./src/*"]
    }
  }
}
