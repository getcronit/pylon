{
  "extends": "@getcronit/pylon/tsconfig.pylon.json",
  "include": [
    "pylon.d.ts",
    "pylon.config.ts",
    "src/**/*.ts",
    "pages",
    "components",
    "lib",
    ".pylon"
  ],
  "compilerOptions": {
    // No baseUrl (deprecated → removed in TS 7.0); `@/*` resolves relative to this
    // config's directory, which is what baseUrl:"." did.
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-jsx"
  }
}
