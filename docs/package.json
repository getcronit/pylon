{
  "name": "@getcronit/pylon-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pylon documentation & marketing site — built with Pylon + usePages",
  "scripts": {
    "dev": "pylon dev -c \"node --enable-source-maps .pylon/server.mjs\"",
    "build": "pylon build",
    "start": "node --enable-source-maps .pylon/server.mjs",
    "check:coverage": "node coverage/check.mjs",
    "check:examples": "node coverage/check-examples.mjs"
  },
  "dependencies": {
    "@getcronit/pylon": "workspace:*",
    "@getcronit/pylon-pages": "workspace:*",
    "@getcronit/pylon-query": "workspace:*",
    "@hono/node-server": "^1.12.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@shikijs/rehype": "^1.24.0",
    "@shikijs/transformers": "^1.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-directive": "^3.0.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^1.24.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
