  "devDependencies": {
    "@getcronit/pylon-dev": "workspace:*",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.4"
  }
