{
  "compilerOptions": {
    // enable latest features
    "lib": ["esnext"],
    "module": "esnext",
    "target": "esnext",

    "moduleResolution": "bundler", // support `import` from `node_modules`
    "noImplicitAny": false,
    "noImplicitThis": false,

    "jsx": "react-jsx", // support JSX
    "allowJs": true, // allow importing `.js` from `.ts`
    "esModuleInterop": true, // allow default imports for CommonJS modules

    // best practices
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true
  },
  // Base config only: it supplies shared compilerOptions to the configs that
  // `extends` it (packages/create-pylon). It must NOT compile anything itself —
  // without an empty `files`, `tsc` globs the whole monorepo (docs, packages, e2e)
  // under one flat config and reports hundreds of phantom errors. Per-project
  // type-checking runs each workspace's own tsconfig (see the root `typecheck` script).
  "files": [],
  "exclude": ["node_modules", "dist"]
}
